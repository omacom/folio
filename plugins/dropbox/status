#!/bin/sh
# Marks the Dropbox folder with Dropbox's own mark, even without dropbox-cli.
# Its state isn't said on the row: Dropbox shows that itself, and a word
# beside the folder only took room from its name. While Dropbox runs, its
# files can be shared by link.
if [ ! -d "$HOME/Dropbox" ]; then
  echo '{}'
  exit 0
fi
# Without an actions list every action would be on, so it's always there.
actions=', "actions": []'
if command -v dropbox-cli >/dev/null 2>&1; then
  case "$(dropbox-cli status 2>/dev/null | tr 'A-Z' 'a-z')" in
    "" | *"isn't running"*) ;;
    *) actions=', "actions": ["link"]' ;;
  esac
fi
printf '{"places": [{"path": "~/Dropbox", "icon": "dropbox.svg"}]%s}\n' "$actions"
